# MuleRun registration
MR_INVITE_URL=https://mulerun.com/invitation/YOUR_INVITE_CODE
MR_OUTLOOK_ACCOUNTS=accounts.outlook.csv
MR_DEFAULT_PASSWORD=change-me
MR_CONCURRENCY=2
MR_HEADLESS=1
# Optional proxy for browser automation
# MR_PROXY_SERVER=socks5://127.0.0.1:17920

# MuleRun pool proxy
PROXY_API_KEY=change-this-admin-key
CREDENTIALS_FILE=./credentials.json
STATE_FILE=./state.json
PROXY_PORT=8089
UPSTREAM_BASE_URL=https://api.mulerun.com
MAX_FAILURES=3
BACKOFF_BASE=60
BACKOFF_CAP=86400
